___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const makeString = require('makeString');

// The loader reads the site key from its own address and adds the chat bubble with it.
const LOADER_URL = 'https://humanreply.app/gtm/loader-1.js?site=';

const siteKey = makeString(data.siteKey || '').trim();

if (!siteKey) {
  data.gtmOnFailure();
  return;
}

injectScript(LOADER_URL + encodeUriComponent(siteKey), data.gtmOnSuccess, data.gtmOnFailure, 'humanreply');


